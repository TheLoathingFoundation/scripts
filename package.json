{
  "name": "tlf",
  "version": "0.0.0",
  "author": "slifty <slifty@gmail.com>",
  "homepage": "https://foundation.loathers.net",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "lint": "yarn lint:prettier && yarn lint:eslint",
    "lint:prettier": "prettier --check src/**/*.ts src/*.ts",
    "lint:eslint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.ts src/*.ts",
    "install-mafia": "create-kolmafia-script --install",
    "test": "vitest run",
    "update-participants": "node src/scripts/updateParticipants.mjs && yarn format"
  },
  "dependencies": {
    "grimoire-kolmafia": "^0.3.33",
    "kolmafia": "latest",
    "libram": "^0.11.29"
  },
  "devDependencies": {
    "@babel/core": "^8",
    "@babel/preset-env": "^8",
    "@babel/preset-typescript": "^8",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/node": "^26.4.0",
    "create-kolmafia-script": "latest",
    "csv-parse": "^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-libram": "^0.6.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
